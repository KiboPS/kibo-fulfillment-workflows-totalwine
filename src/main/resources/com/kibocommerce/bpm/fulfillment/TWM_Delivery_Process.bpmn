    <bpmn2:userTask id="_6F858FF6-22F2-4840-9F80-EF086D827330" name="Prepare for Delivery">
      <bpmn2:documentation id="_snvevyzTEfGp-frUimHysQ"><![CDATA[Delivery Preparation User Task]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Prepare for Delivery]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[if (Boolean.TRUE.equals(kcontext.getVariable("assemblyRequired"))) {
    if ("PARTIAL_STOCK".equals(kcontext.getVariable("stockLevel"))) {
        kcontext.setVariable("currentState","PARTIAL_INVENTORY_READY_FOR_ASSEMBLY");
    } else {
        kcontext.setVariable("currentState","READY_FOR_ASSEMBLY");
    }
}
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[if (Boolean.TRUE.equals(back)) {
kcontext.setVariable("back", false);
if ("IN_STOCK".equals(stockLevel)) {
    kcontext.setVariable("currentState","INVENTORY_AVAILABLE");
} else if ("PARTIAL_STOCK".equals(stockLevel)) {
    kcontext.setVariable("currentState","PARTIAL_INVENTORY_NOPE");
} else if ("NO_STOCK".equals(stockLevel)) {
    kcontext.setVariable("currentState","INVENTORY_NOPE");
}
kcontext.getKieRuntime().signalEvent("back", null, kcontext.getProcessInstance().getId());
}
if (!Boolean.TRUE.equals(kcontext.getVariable("assemblyRequired")) || Boolean.TRUE.equals(kcontext.getVariable("assemblyCompleted"))) {
    kcontext.setVariable("currentState","READY_FOR_DELIVERY");
}
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
