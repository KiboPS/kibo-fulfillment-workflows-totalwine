    <bpmn2:userTask id="_6435A331-0795-4719-989B-F9FB69570FC5" name="Delivery Confirmation">
      <bpmn2:documentation id="_VDvT0D8BEfG_yuMTXqMvJw"><![CDATA[Delivery Confirmation User Task]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Delivery Confirmation]]></drools:metaValue>
        </drools:metaData>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[if (Boolean.TRUE.equals(canceled)) {
    kcontext.setVariable("currentState","CANCELED");
} else if (Boolean.TRUE.equals(kcontext.getVariable("deliveryReturned"))) {
    kcontext.setVariable("currentState","DELIVERY_RETURNED_TO_STORE");
} else {
    kcontext.setVariable("currentState","COMPLETED");
}]]></drools:script>
        </drools:onExit-script>
